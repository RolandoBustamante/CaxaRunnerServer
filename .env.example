# Base de datos PostgreSQL.
DATABASE_URL=postgresql://usuario:password@host:5432/caxarunner?schema=smart

# Puerto del backend.
PORT=3001

# Secreto para firmar JWT.
JWT_SECRET=change_me

# URL publica del frontend. Importante para links enviados por WhatsApp.
# Local en red: http://192.168.1.50:5173
# Produccion: https://inscripciones.cajamarcarunners.com
PUBLIC_APP_URL=https://inscripciones.cajamarcarunners.com

# Contactos fallback para alertas WhatsApp si la carrera no tiene contactos propios.
# Separar por coma.
WHATSAPP_ADMIN_NUMBERS=

# Rutas opcionales para assets de certificados.
CERTIFICATE_LOGO_PATH=
CERTIFICATE_WATERMARK_PATH=
CERTIFICATE_TRAIL_LOGO_PATH=
CERTIFICATE_TRAIL_CAJAMARCA_LOGO_PATH=

# Ruta opcional a Chrome/Chromium para generar PDF/imagenes si Playwright lo necesita.
PDF_BROWSER_PATH=
